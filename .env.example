# Application
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# PostgreSQL Database Connection
DATABASE_URL=postgresql://smartcampus_user:smartcampus_password@localhost:5432/smartcampus_db?schema=public

# Database credentials for Docker Compose
POSTGRES_USER=smartcampus_user
POSTGRES_PASSWORD=smartcampus_password
POSTGRES_DB=smartcampus_db
POSTGRES_PORT=5432

# Authentication & Security
JWT_SECRET=supersecret_jwt_key_smartcampus_devfusion_2026_change_in_prod
COOKIE_SECRET=supersecret_cookie_key_smartcampus_devfusion_2026
SESSION_EXPIRES_IN=7d
CSRF_SECRET=supersecret_csrf_key_smartcampus_devfusion_2026

# Google OAuth Credentials (Optional in dev, required for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMTP Email Configuration (Optional in dev; safely logs to console if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="SmartCampus Admin <no-reply@smartcampus.edu>"

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
